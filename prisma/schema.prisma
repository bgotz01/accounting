generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  avatarUrl        String?  @map("avatar_url")
  customCategories String[] @default([]) @map("custom_categories")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  files      File[]
  transactions Transaction[]
  adSpend    AdSpend[]
  aiInsights AiInsight[]
  chatConversations ChatConversation[]
  businessProfile   BusinessProfile?
  invoices   Invoice[]

  @@map("users")
}

model File {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  filename         String
  fileType         String   @map("file_type")
  storagePath      String   @map("storage_path")
  category         String   @default("other")
  period           String?
  processingStatus String   @default("pending") @map("processing_status")
  createdAt        DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  adSpend      AdSpend[]
  invoices     Invoice[]

  @@map("files")
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  fileId          String?  @map("file_id")
  date            DateTime
  description     String
  counterparty    String?
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  sourceCategory    String?  @map("source_category")
  financialCategory String?  @map("financial_category")
  type            String
  confidenceScore Float?   @map("confidence_score")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model AiInsight {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  content   String
  severity  String   @default("info")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

model Invoice {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  fileId      String?   @map("file_id")
  vendor      String
  invoiceNumber String? @map("invoice_number")
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  issueDate   DateTime  @map("issue_date")
  dueDate     DateTime? @map("due_date")
  paidDate    DateTime? @map("paid_date")
  status      String    @default("unpaid") @map("status") // "unpaid" | "paid" | "overdue"
  category    String    @default("other")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

model AdSpend {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  fileId      String?  @map("file_id")
  date        DateTime
  platform    String   @default("meta")
  campaign    String
  spend       Decimal  @db.Decimal(12, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  purchases   Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  roas        Float?
  createdAt   DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@map("ad_spend")
}

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("New chat")
  messages  Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_conversations")
}

model BusinessProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  businessName       String   @map("business_name")
  industry           String?
  currency           String   @default("USD")
  country            String?
  taxId              String?  @map("tax_id")
  fiscalYearStart    Int      @default(1) @map("fiscal_year_start") // 1 = January
  accountingStandard String   @default("GAAP") @map("accounting_standard") // "GAAP" | "IFRS"
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}
